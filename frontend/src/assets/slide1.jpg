<script>
    
// Select both buttons
const textButton = document.getElementById('text');
const videosButton = document.getElementById('videos');

// Select both content areas
const textArea = document.getElementById('text-area');
const vidsArea = document.getElementById('vids-area');

// Function to handle click on text button
textButton.addEventListener("click", function () {
    // Set background color and color of text button to black
    textButton.style.backgroundColor = 'black';
    textButton.style.color = 'white';
    // Revert background color and color of videos button to its original color
    videosButton.style.backgroundColor = '';
    videosButton.style.color = ''; // Added this line

    // Hide text area and display videos area
    textArea.style.display = "block";
    vidsArea.style.display = "none";
});

// Function to handle click on videos button
videosButton.addEventListener("click", function () {
    // Set background color and color of videos button to black
    videosButton.style.backgroundColor = 'black';
    videosButton.style.color = 'white';
    // Revert background color and color of text button to its original color
    textButton.style.backgroundColor = '';
    textButton.style.color = ''; // Added this line
    
    // Hide videos area and display text area
    textArea.style.display = "none";
    vidsArea.style.display = "block";
});

    
</script>


