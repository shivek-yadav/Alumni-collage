<style>
<style>
    /* Popup Overlay */
.popup-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
}

/* Popup Content */
.popup-content {
    position: relative;
    background: #fff;
    padding: 20px;
    margin: 10% auto;
    width: 80%;
    max-width: 600px;
    border-radius: 8px;
    z-index: 1001;
}

/* Close Button */
.popup-close {
    position: absolute;
    top: 10px;
    right: 20px;
    font-size: 24px;
    cursor: pointer;
}

/* Table Styling */
.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.fixed-width {
    width: 100%;
    border-collapse: collapse;
}

.fixed-width th,
.fixed-width td {
    padding: 8px 12px;
    border: 1px solid #ddd;
}

.right-column {
    text-align: right;
}

</style>
<!-- end Simple Custom CSS and JS -->
