<script>
// Select all semester buttons

const semesterButtons = document.querySelectorAll('.semester-button');

// Select all semester divs

const semesters = document.querySelectorAll('.semester');

// Function to handle click on semester button

function handleButtonClick(index) {
    // Hide all semesters
    semesters.forEach(function(semester) {
        semester.style.display = "none";
    });
    // Display the corresponding semester
    semesters[index].style.display = "block";

    // Remove the 'active-button' class from all buttons
    semesterButtons.forEach(function(btn) {
        btn.classList.remove('active-button');
    });
    // Add the 'active-button' class to the clicked button
    semesterButtons[index].classList.add('active-button');
}

// Add click event listener to each semester button
semesterButtons.forEach(function(button, index) {
    button.addEventListener("click", function () {
        // Call the function to handle button click
        handleButtonClick(index);
    });
});


// to show  first semester  button active when page load 
window.onload = function() {
   
    let semester1btn = document.getElementById('semester1-btn');
    semester1btn.classList.add('active-button');
};



</script><!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
        document.addEventListener('DOMContentLoaded', function() {
            var missionContent = document.getElementById('mission-content');
            var visionContent = document.getElementById('vision-content');
            var valuesContent = document.getElementById('core-values');
            
            if (missionContent && visionContent && valuesContent) {
                visionContent.style.display = 'block';
                missionContent.style.display = 'none';
                valuesContent.style.display = 'none';

                // Add event listeners to each button
                document.getElementById('mission-button').addEventListener('click', function() {
                    missionContent.style.display = 'block';
                    visionContent.style.display = 'none';
                    valuesContent.style.display = 'none';
                });

                document.getElementById('vision-button').addEventListener('click', function() {
                    missionContent.style.display = 'none';
                    visionContent.style.display = 'block';
                    valuesContent.style.display = 'none';
                });

                document.getElementById('values-button').addEventListener('click', function() {
                    missionContent.style.display = 'none';
                    visionContent.style.display = 'none';
                    valuesContent.style.display = 'block';
                });
            } else {
                console.error('One or more content elements not found.');
            }
        });
    </script><!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
    // Get the popup and the button
    var popup = document.getElementById("custom-popup");
    var triggerButton = document.getElementById("open-popup");
    var closeButton = document.querySelector(".popup-close");

    // Open the popup when the button is clicked
    triggerButton.addEventListener("click", function() {
        popup.style.display = "block";
    });

    // Close the popup when the close button is clicked
    closeButton.addEventListener("click", function() {
        popup.style.display = "none";
    });

    // Close the popup when clicking outside of the popup content
    window.addEventListener("click", function(event) {
        if (event.target == popup) {
            popup.style.display = "none";
        }
    });
});

</script>
<!-- end Simple Custom CSS and JS -->
          
              

