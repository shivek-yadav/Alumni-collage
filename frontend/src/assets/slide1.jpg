body {
    font-family: 'Montserrat', sans-serif !important;
}


/*  popup contact form */

#splite_popup_description {
    color: #484848;
    font-family: Noto Sans;
    font-size: 13px;
    line-height: 18px;
    text-align: center;
    display: none;
}



.jeg-elementor-kit.jkit-tabs .tab-content-list .tab-content.active {
    display: block;
    opacity: 1;
    text-align: justify;
    text-justify: inter-word;
}



/* /hackathon*/


.singular .entry-header {
    border-bottom: 3px solid var(--global--color-border);
    padding-bottom: calc(2 * var(--global--spacing-vertical));
    margin-bottom: calc(3 * var(--global--spacing-vertical));
    display: none;
}

#nf-form-4-cont {
    border-radius: 50px !important;
    box-shadow: 2px 5px 20px #000;

}

/* removed sections */

.widget-area {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: calc(2 * var(--global--spacing-horizontal));
    display: none;
}

.elementor-189 .elementor-element.elementor-element-3e365947:not(.elementor-motion-effects-element-type-background),
.elementor-189 .elementor-element.elementor-element-3e365947>.elementor-motion-effects-container>.elementor-motion-effects-layer {
    background-color: #b21c1c;
    display: none;
}


.entry-footer {
    color: var(--global--color-primary);
    clear: both;
    float: none;
    font-size: var(--global--font-size-xs);
    display: block;
    display: none
}


button:not(:hover):not(:active):not(.has-background),
input[type=submit]:not(:hover):not(:active):not(.has-background),
input[type=reset]:not(:hover):not(:active):not(.has-background),
.wp-block-search .wp-block-search__button:not(:hover):not(:active):not(.has-background),
.wp-block-button .wp-block-button__link:not(:hover):not(:active):not(.has-background),
.wp-block-file a.wp-block-file__button:not(:hover):not(:active):not(.has-background) {
    background-color: var(--global--color-primary);

}

.sub-menu-toggle {
    display: none !important;
}



/* new ggi home page*/
.hover-text {
    opacity: 0;
}

.hover-text:hover {
    opacity: 1;
    transition: .5s;
    cursor: pointer;
}

.elementor-gallery__titles-container>a {
    color: #36348E;
    border: 1px solid;
    border-radius: 7px;

}


.elementor-gallery__titles-container>a:hover {
    border: 1px solid;
    border-radius: 7px;
    background-color: #024D96;
    color: #fff !important;

}


.elementor-gallery__titles-container>a:active {
    background-color: #024D96 !important;

}


/* cources */
/*  Select The Right Course  section */

#select-right-course .elementor-main-swiper .swiper-slide {
    height: 640px !important;
}



/* home page */
.bdt-ep-static-carousel-item {
    height: 450px !important;
    background-color: #f4f4f4;
}

.link {
    color: #0270B4 !important;
    font-size: 15px;
    font-weight: 500;


}


.elementor-testimonial__header {
    flex-direction: column;
}

.elementor-9322 .elementor-element.elementor-element-dda3d3f .elementor-testimonial__image img {
    width: 100px;
    height: 100px;
    border-radius: 10px !important;
    width: 100% !important;
    height: auto !important;
}

.elementor-testimonial__cite {
    margin-left: 0 !important;
}


#star {
    display: inline-block !important;
    float:right;
}

.elementor-star-rating {
    display: none !important;
}

.elementor-widget-reviews.elementor-review--has-separator .elementor-testimonial__header {
    border-bottom: none !important;
}

.swiper {
    padding: 10px 15px 15px;

}

.elementor-widget-reviews .swiper-slide,
.elementor-widget-testimonial-carousel .swiper-slide {
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;

}

#course-btn {
    display: flex;
    justify-content: center;
    margin-bottom: 15px !important;
}


#course-btn h5 {
    background-color: #0270B4;
    color: #fff;
    padding: 10px 20px;
    border-radius: 3px;
    font-size: 17px;
    margin-top: 20px;
    margin-bottom: -10px;

}


#course-btn h5:hover {
    background-color: #F9C10D;
    color: #0270B4;
    cursor: pointer;
    transition: .5s;

}

/* course details page	 */

@media (max-width:700px) {
    .semester-button {
        padding: 5px 0px !important;
        margin: 5px !important;
        font-size: 13 !important;

    }
}


.elementor-toggle-item {
    border-radius: 20px;
    margin-bottom: 18px;
    background-color: #EFF1F4B2;
}





[class*="jki jki-"] {
    font-size: 20px;
    background-color: #F7F7FF;
    padding: 2px;
    border-radius: 3px;
    box-shadow: 1px 2px 2px #dbdbdb;
    transition: .3s;
}

[class*="jki jki-"]:hover {
    background-color: #0270b4;
    color: #fff !important;

}


.fa-minus {
    width: 30px;
    text-align: center;
    font-size: 15px !important;
    background-color: #0270B4;
    padding: 2px;
    border-radius: 3px;
    box-shadow: 1px 2px 2px #dbdbdb;
}

/* yellow what 0ur students say section */

.elementor-main-swiper .swiper-slide {
    border-radius: 5px;
    padding: 20px;
    box-shadow: none;
}

/* home page event gallery */

.elementor-8368 .elementor-element.elementor-element-b58ba4b .elementor-gallery-title {
    --space-between: 11px;
    margin-bottom: 15px;
}

/* leadership team */
.bdt-panel-slider .bdt-panel-slide-item {
    transform: skew(-0deg);
    border-radius: 7px;
}



/* campus Life */


.layer-div {
    Height: 240px;
    overflow: hidden;
    background-size: cover;
}

.layer-div-sports {
    Height: 495px;
    overflow: hidden;
    background-size: cover;
}

.campus-link {
    color: #fff !important;
}


.layer h4, .layer-div h4 {
    color: #fff !important;
	font-weight:500;
}

