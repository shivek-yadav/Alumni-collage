      color:#fff !important;
  } */

/* ------ */
.layer {
    Margin-top: 300px;
    Margin-left: 0%;
    Margin-right: 0%;
    transition-duration: 0.3s;
    background-color: #0270B4;
    border-radius: 0 0 10px;
    padding: 5px;
}

/* ------ */
.layer:hover {
    margin: 0;
    height: 230px;
    padding: 50px 10px;
    background-color: #0270B4AB;
    border-radius: 10px;
    cursor: pointer;
}

/* ------ */

#layer-2 {
    Margin-top: 253px;
    padding: 0px 65px;
}

#layer-2:hover {
    Margin-top: 0px;
    height: 240px;
    padding: 50px 20px;
    border-radius: 10px;
}

/* ------ */
#layer-3 {
    Margin-top: 275px;
    padding: 2px 66.4px;
}

#layer-3:hover {
    Margin-top: 0px;
    height: 240px;
    padding: 50px 20px;
    border-radius: 10px;
}

/* ------ */
#layer-sports {
    Margin-top: 525px;

}


#layer-sports:hover {
    Margin-top: 0px;
    height: 490px;
    padding: 50px 20px;
    border-radius: 10px;

}


/*media query @1024px*/
@media screen and (max-width: 1024px) {

    /* ------ */
    .layer {
        Margin-top: 260px;
    }

}

