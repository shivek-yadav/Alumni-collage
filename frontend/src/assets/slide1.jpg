<!-- news update -->

<style>
/* scroll area */
.events-section {
  max-width: 1200px;
  max-height: 500px;
  overflow-x: auto !important;
  overflow-y: hidden !important;
  display: flex !important;
  flex-wrap: nowrap !important;
  align-items: flex-start;
  gap: 20px;
  background: #f3f3f3;
  padding-bottom: 10px;
  box-sizing: border-box;

  /* firefox default thumb | track */
  scrollbar-width: thin;
  scrollbar-color: #0270b4 #dfe6ee;

  color: #0270b4; /* text/icon color */
}

/* hover: change text color + firefox thumb color */
.events-section:hover {
  color: #f9c10d;                  /* text on hover */
  scrollbar-color: #f9c10d #dfe6ee;/* firefox thumb | track on hover */
}

/* keep cards from stretching */
.events-section > * {
  flex: 0 0 auto !important;
}

/* chrome / edge / safari scrollbar */
.events-section::-webkit-scrollbar {
  height: 8px; /* thickness */
}
.events-section::-webkit-scrollbar-track {
  background: #dfe6ee; /* track */
}
.events-section::-webkit-scrollbar-thumb {
  background: #0270b4;             /* default thumb */
  border-radius: 10px;
  transition: background-color 0.5s ease;
}
/* hover thumb (webkit) */
.events-section:hover::-webkit-scrollbar-thumb,
.events-section::-webkit-scrollbar-thumb:hover {
  background: #f9c10d; /* hover thumb color */
}

/* inner tab size - unchanged */
.elementor-34566 .elementor-element.elementor-element-0ad295d:not(.elementor-motion-effects-element-type-background),
.elementor-34566 .elementor-element.elementor-element-0ad295d > .elementor-motion-effects-container > .elementor-motion-effects-layer {
  width: 260px;
  height: 345px;
}
</style>

          
